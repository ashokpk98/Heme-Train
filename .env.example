# Postgres connection. For Supabase use the *pooled* connection string from
# Project Settings -> Database -> Connection string -> Transaction pooler.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/heme

# Supabase project — Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key. Server-side only; never expose to the browser.
# Used by the seed script to create auth users. Rotate after seeding.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
